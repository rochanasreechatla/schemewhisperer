# Scheme Whisperer - Environment Configuration
# Copy this file to .env and fill in your Gemini API key

# Google Gemini API Key (Get yours at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (Default: 3000 for local development, 8080 for Cloud Run)
PORT=3000
